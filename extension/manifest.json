{
  "manifest_version": 3,
  "key": "",
  "name": "Sentinel AI - Phishing & Privacy Guard",
  "version": "1.0.0",
  "description": "Next-generation browser security and privacy guardian against phishing campaigns, social engineering, and identity data leaks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel AI Security & Privacy Guard",
    "default_icon": {
      "16": "logos/purple_minimal_16.png",
      "32": "logos/purple_minimal_32.png",
      "48": "logos/purple_minimal_48.png",
      "128": "logos/purple_minimal_128.png"
    }
  },
  "icons": {
    "16": "logos/purple_emblem_16.png",
    "32": "logos/purple_emblem_32.png",
    "48": "logos/purple_emblem_48.png",
    "128": "logos/purple_emblem_128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "gmailOverlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "identity"
  ],
  "oauth2": {
    "client_id": "209983686122-p3tt8l4m85c9efp6r57hnmq5tmh4ci2q.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logos/*.svg",
        "logos/*.png",
        "gmailOverlay.css"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
